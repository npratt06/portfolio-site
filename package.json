{
    "name": "portfolio-site",
    "version": "0.1.0",
    "description": "Personal portfolio site for Nate Pratt, built with React, TypeScript, Vite and GitHub Pages.",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/npratt06/portfolio-site.git"
    },
    "homepage": "https://npratt06.github.io/portfolio-site/",
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.30.4"
    },
    "scripts": {
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "dev": "vite --host 127.0.0.1",
        "dev:network": "vite --host 0.0.0.0",
        "start": "npm run dev",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "lint": "eslint .",
        "prettier-format": "prettier --config .prettierrc src/**/*.tsx --write"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.0.0",
        "gh-pages": "^6.3.0",
        "globals": "^15.0.0",
        "prettier": "2.7.1",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^7.0.0",
        "vitest": "^3.0.0"
    }
}
